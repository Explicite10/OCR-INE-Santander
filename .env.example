# ---------- Local (Mac + Ollama) ----------
VLM_BACKEND=ollama
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:8b-instruct

# ---------- Servidor con GPU (vLLM, API compatible con OpenAI) ----------
# VLM_BACKEND=openai
# VLM_BASE_URL=http://localhost:8001/v1
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLM_API_KEY=EMPTY

VLM_TIMEOUT_S=180
VLM_MAX_SIDE=1600

# Resolución de render de PDFs (250 es buen balance velocidad/calidad)
RENDER_DPI=250

# Documentos procesándose a la vez en la API (el OCR de uno se traslapa con el VLM del otro)
MAX_CONCURRENT_JOBS=2

# Si un campo se reconstruyó (p. ej. CURP tapada por un sello), mandar a revisión
REVISAR_RECONSTRUIDOS=true

# Rechazar lo que no parece una credencial INE mexicana (estado "rechazado" con el motivo en "error").
# Texto de otro documento (licencia, pasaporte, IMSS, RFC...) rechaza de inmediato, sin gastar el VLM.
# Si el OCR simplemente no vio señales de INE (copia tenue, credencial inclinada o chica), el documento
# sigue al VLM y se rechaza al final sólo si tampoco él encontró encabezado, MRZ ni clave de elector válida.
RECHAZAR_NO_INE=true
INE_MIN_SENALES=2
# Sin anclas en ninguna página, el VLM ubica las credenciales y se repite el OCR sobre esos recortes
VLM_LOCALIZADOR=true
# La API sólo acepta PDF (400 ARCHIVO_NO_SOPORTADO para otro formato); false = también JPEG, PNG, TIFF y WEBP
SOLO_PDF=true
# Un PDF con más páginas responde 224 (LIMITE_PAGINAS); sólo se analizan las primeras 4
MAX_PAGINAS_DOCUMENTO=15

# Si se define, la API exige el header X-API-Key (recomendado en servidor)
# API_KEY=cambia-esto

# ---------- Docker (servidor) ----------
# Puerto donde queda la API en el servidor
API_PORT=18473
# Ollama: peticiones al modelo a la vez y ahorro de VRAM (GPU de 8 GB como la RTX 4060,
# compartida con otros procesos). Configuración conservadora: 1 en la GPU, 2 en la API.
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
VLM_NUM_CTX=4096
# Usar siempre también el archivo de GPU sin escribir los dos -f en cada comando
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Carpeta del servidor para pruebas por lote (PDFs y resultados); dentro del contenedor es /app/lote
LOTE_DIR=./lote
# Contraseña de PostgreSQL (OBLIGATORIA en Docker; cámbiala)
POSTGRES_PASSWORD=Buzzword2026
# Guardar cada resultado en la base de datos (en Docker la base ya viene configurada)
GUARDAR_RESULTADOS=true
# Local sin Docker (opcional): DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/ine
# Documentación interactiva de los endpoints en "/docs" (apágala en producción si no la usas)
ENABLE_DOCS=true


#brew services start ollama
#brew services stop ollama

#ollama serve
#cd ~/Desktop/IA/ine-ocr-api && .venv/bin/uvicorn app.main:app --port 8000